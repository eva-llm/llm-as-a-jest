{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./dst",
    "strict": true,
    "declaration": true,
    "removeComments": true,
    "emitDeclarationOnly": false,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["./src"],
  "exclude": ["node_modules", "dst"]
}
